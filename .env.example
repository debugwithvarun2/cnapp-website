# ==============================================================================
# Carbon Signal — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# Google / Gmail SMTP Email Configuration
# ------------------------------------------------------------------------------
# How to get your Google App Password:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Make sure "2-Step Verification" is ON.
# 3. Go to "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Create a new app password named "Carbon Signal".
# 5. Copy the 16-letter password and paste it into SMTP_PASS below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-google-app-password

# Email displayed to prospects in confirmation emails
SMTP_FROM="Carbon Signal Security" <your-account@gmail.com>

# Destination email for internal lead notification alerts
SMTP_TO=your-account@gmail.com
